# ==============================================================================
# DHANDHA — Environment Configuration Template
# Kaam bhi. Khana bhi.
# ==============================================================================

# Server & Application
PORT=8080
SPRING_PROFILES_ACTIVE=dev
APP_URL=http://localhost:3000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dhandha_db
DB_USER=dhandha_user
DB_PASSWORD=dhandha_secure_password_2024
DB_POOL_SIZE=20

# Redis Cache & Session Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & Security
JWT_SECRET=dhandha_jwt_super_secret_signing_key_min_256_bits_for_hmac_sha256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30

# Google OAuth 2.0 Credentials (Console: https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

# Phone OTP Service (Twilio / Fast2SMS / Gupshup / Exotel)
OTP_PROVIDER=FAST2SMS
FAST2SMS_API_KEY=your_fast2sms_api_key_here
OTP_EXPIRY_MINUTES=5

# Razorpay Indian Payment Gateway (Dashboard: https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# S3 / Object Storage (AWS S3, Cloudflare R2, MinIO)
STORAGE_PROVIDER=S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=dhandha-public-assets

# Maps & Geolocation (Optional Feature Flag: MAPS_ENABLED)
MAPS_ENABLED=false
GOOGLE_MAPS_API_KEY=your_optional_google_maps_api_key

# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_NAME="DHANDHA"
NEXT_PUBLIC_APP_TAGLINE="Kaam bhi. Khana bhi."
NEXT_PUBLIC_DEFAULT_CITY="Delhi NCR"
